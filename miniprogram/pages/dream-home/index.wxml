<view class="home">
  <!-- Hero -->
  <view class="hero">
    <view class="hero-glow"></view>
    <view class="hero-moon">🌙</view>
    <view class="hero-title">Floydream</view>
    <view class="hero-sub">把昨夜的梦，轻轻放在这里</view>
    <view class="hero-desc">梦是潜意识的信使。先记下来，再慢慢听懂它在说什么。</view>
    <view class="hero-actions">
      <button class="btn-primary" bindtap="goCreate">✦ 记录新的梦</button>
    </view>
  </view>

  <!-- Stats -->
  <view class="stats-row">
    <view class="stat-card glass-card">
      <view class="stat-num">{{stats.total}}</view>
      <view class="stat-label">总记录</view>
    </view>
    <view class="stat-card glass-card">
      <view class="stat-num">{{stats.interpreted}}</view>
      <view class="stat-label">已解读</view>
    </view>
    <view class="stat-card glass-card">
      <view class="stat-num">{{stats.streak}}</view>
      <view class="stat-label">有梦天数</view>
    </view>
  </view>

  <!-- Latest dream -->
  <view wx:if="{{latestDream}}" class="latest-section">
    <view class="section-header">
      <text class="section-label">最近一场梦</text>
      <text class="section-sub">{{latestDream.relativeText}}</text>
    </view>
    <view class="latest-card elevated-card" bindtap="goDetail" data-id="{{latestDream.id}}">
      <view class="latest-head">
        <view class="latest-title">{{latestDream.title || '未命名的梦'}}</view>
        <view class="chip">{{latestDream.mood}}</view>
      </view>
      <view class="latest-preview">{{latestDream.preview}}</view>
      <view wx:if="{{latestDream.analysis}}" class="latest-insight">
        <view class="insight-icon">🔮</view>
        <view class="insight-text">{{latestDream.analysis.summary}}</view>
      </view>
      <view wx:else class="latest-no-insight">
        <view class="insight-icon">💤</view>
        <view class="insight-text dim">等待解读中…</view>
      </view>
    </view>
  </view>

  <!-- Recent list -->
  <view class="recent-section">
    <view class="section-header">
      <text class="section-label">最近梦境</text>
    </view>

    <view wx:if="{{recentDreams.length}}">
      <view
        wx:for="{{recentDreams}}"
        wx:key="id"
        class="dream-item elevated-card"
        bindtap="goDetail"
        data-id="{{item.id}}"
      >
        <view class="item-top">
          <view class="item-title">{{item.title || '未命名的梦'}}</view>
          <view class="item-date">{{item.createdAtText}}</view>
        </view>
        <view class="item-body">{{item.preview}}</view>
        <view class="item-foot">
          <view class="chip">{{item.mood}}</view>
          <view class="item-status">{{item.analysis ? '🔮 已解读' : '💤 仅记录'}}</view>
        </view>
      </view>
    </view>

    <view wx:else class="empty-card elevated-card">
      <view class="empty-icon">🌌</view>
      <view class="empty-title">你的梦境档案还没有开始</view>
      <view class="empty-desc">哪怕只记住一个片段、一种颜色或一句话，都值得留下。</view>
      <button class="btn-primary" bindtap="goCreate">写下第一条梦境</button>
    </view>
  </view>
</view>
