.home {
  min-height: 100vh;
  padding: 0 28rpx 72rpx;
  box-sizing: border-box;
}

.hero {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 54rpx 20rpx 38rpx;
  text-align: center;
  overflow: hidden;
}

.hero-glow {
  position: absolute;
  top: -80rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 520rpx;
  height: 520rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 195, 123, 0.30) 0%, rgba(255, 195, 123, 0.08) 42%, transparent 72%);
  pointer-events: none;
}

.hero-badge {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.74);
  border: 1rpx solid rgba(255, 255, 255, 0.82);
  color: #ff8d6a;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.hero-moon {
  font-size: 86rpx;
  line-height: 1;
  margin: 22rpx 0 18rpx;
  filter: drop-shadow(0 12rpx 20rpx rgba(255, 165, 120, 0.24));
}

.hero-title {
  font-size: 52rpx;
  font-weight: 700;
  color: #3b486b;
  letter-spacing: 4rpx;
  background: linear-gradient(135deg, #ff8c6a 0%, #f29d57 52%, #63b8b1 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.hero-sub {
  margin-top: 16rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: #4e5372;
  letter-spacing: 1rpx;
}

.hero-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #7d819d;
  max-width: 480rpx;
  line-height: 1.7;
}

.hero-actions {
  display: flex;
  flex-direction: column;
  width: 100%;
  max-width: 440rpx;
  margin-top: 34rpx;
}

.stats-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 36rpx;
}

.stat-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 26rpx 12rpx;
}

.stat-card:active {
  transform: translateY(2rpx);
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #ff8f6d, #4eb2ae);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.stat-label {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #8890a9;
  letter-spacing: 1rpx;
}

.latest-section {
  margin-bottom: 36rpx;
}

.section-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 8rpx;
  margin-bottom: 16rpx;
}

.section-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #c4b5fd;
  letter-spacing: 1rpx;
}

.section-sub {
  font-size: 22rpx;
  color: #9a94aa;
}

.section-link {
  font-size: 22rpx;
  color: #ff916d;
}

.latest-card {
  padding: 28rpx;
}

.latest-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.latest-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #45506f;
}

.latest-preview {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.8;
  color: #6e7393;
}

.latest-tags,
.latest-no-insight {
  display: flex;
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: rgba(255, 241, 225, 0.90);
  border: 1rpx solid rgba(255, 214, 185, 0.86);
}

.insight-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.insight-text {
  font-size: 24rpx;
  line-height: 1.7;
  color: #926a4d;
}

.insight-text.dim {
  color: #7b7f98;
}

.recent-section {
  margin-bottom: 20rpx;
}

.dream-item {
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
}

.dream-item:last-child {
  margin-bottom: 0;
}

.item-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.item-title {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: #47516f;
}

.item-date {
  font-size: 20rpx;
  color: #9d97ad;
  margin-left: 16rpx;
}

.item-body {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #727694;
}

.item-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.item-status {
  font-size: 20rpx;
  color: #8b8fa6;
}

.empty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx;
  text-align: center;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #4c5676;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #7f84a1;
  line-height: 1.7;
  margin-bottom: 32rpx;
  max-width: 400rpx;
}

.empty-card .btn-primary {
  width: 100%;
  max-width: 360rpx;
}
