.home {
  min-height: 100vh;
  padding: 0 28rpx 60rpx;
  box-sizing: border-box;
}

/* === Hero === */
.hero {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 20rpx 44rpx;
  text-align: center;
  overflow: hidden;
}

.hero-glow {
  position: absolute;
  top: -120rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 480rpx;
  height: 480rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(124, 111, 247, 0.18) 0%, rgba(167, 139, 250, 0.06) 40%, transparent 70%);
  pointer-events: none;
}

.hero-moon {
  font-size: 80rpx;
  line-height: 1;
  margin-bottom: 24rpx;
  filter: drop-shadow(0 0 32rpx rgba(167, 139, 250, 0.5));
}

.hero-title {
  font-size: 52rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 4rpx;
  background: linear-gradient(135deg, #e0dfff 0%, #c4b5fd 50%, #f0e6ff 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.hero-sub {
  margin-top: 16rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: #c4b5fd;
  letter-spacing: 2rpx;
}

.hero-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8b83b8;
  max-width: 480rpx;
  line-height: 1.7;
}

.hero-actions {
  display: flex;
  flex-direction: column;
  width: 100%;
  max-width: 440rpx;
  margin-top: 36rpx;
  gap: 16rpx;
}

/* === Stats === */
.stats-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 36rpx;
}

.stat-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 26rpx 12rpx;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  background: linear-gradient(135deg, #e0dfff, #c4b5fd);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.stat-label {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #7b73a8;
  letter-spacing: 1rpx;
}

/* === Latest === */
.latest-section {
  margin-bottom: 36rpx;
}

.section-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 8rpx;
  margin-bottom: 16rpx;
}

.section-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #c4b5fd;
  letter-spacing: 1rpx;
}

.section-sub {
  font-size: 22rpx;
  color: #6b6488;
}

.latest-card {
  padding: 28rpx;
}

.latest-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.latest-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}

.latest-preview {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.8;
  color: #a8a0cc;
}

.latest-insight,
.latest-no-insight {
  display: flex;
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: rgba(167, 139, 250, 0.08);
  border: 1rpx solid rgba(167, 139, 250, 0.12);
}

.insight-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.insight-text {
  font-size: 24rpx;
  line-height: 1.7;
  color: #c4b5fd;
}

.insight-text.dim {
  color: #6b6488;
}

/* === Recent list === */
.recent-section {
  margin-bottom: 20rpx;
}

.dream-item {
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
}

.dream-item:last-child {
  margin-bottom: 0;
}

.item-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.item-title {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: #e0dfff;
}

.item-date {
  font-size: 20rpx;
  color: #6b6488;
  margin-left: 16rpx;
}

.item-body {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #8b83b8;
}

.item-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.item-status {
  font-size: 20rpx;
  color: #6b6488;
}

/* === Empty === */
.empty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx;
  text-align: center;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #e0dfff;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #7b73a8;
  line-height: 1.7;
  margin-bottom: 32rpx;
  max-width: 400rpx;
}

.empty-card .btn-primary {
  width: 100%;
  max-width: 360rpx;
}
