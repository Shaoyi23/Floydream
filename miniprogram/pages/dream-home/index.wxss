.dream-home {
  min-height: 100%;
  padding: 24rpx 24rpx 40rpx;
  box-sizing: border-box;
  background: #f5f4ef;
}

.hero-card,
.latest-card,
.dream-item,
.empty-card,
.stat-card {
  border-radius: 20rpx;
  background: #ffffff;
  border: 1rpx solid #ebe8df;
  box-shadow: none;
}

.hero-card {
  padding: 30rpx 28rpx;
  margin-bottom: 20rpx;
}

.hero-title {
  font-size: 34rpx;
  line-height: 1.4;
  font-weight: 600;
  color: #23262b;
  white-space: nowrap;
}

.hero-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #6f747c;
}

.hero-actions {
  display: flex;
  margin-top: 24rpx;
  justify-content: space-between;
}

.primary-btn,
.ghost-btn {
  width: 48%;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 14rpx;
  font-size: 28rpx;
  margin: 0;
  padding: 0;
}

.primary-btn {
  color: #ffffff;
  background: #2f343b;
}

.ghost-btn {
  color: #4f555d;
  background: #f1efe8;
}

.stats-grid {
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.stat-card {
  width: 31%;
  padding: 22rpx 18rpx;
  text-align: center;
  box-sizing: border-box;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 600;
  color: #23262b;
}

.stat-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8d9299;
}

.section {
  margin-bottom: 24rpx;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 14rpx;
  padding: 0 4rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #23262b;
}

.section-subtitle {
  font-size: 22rpx;
  color: #8d9299;
}

.latest-card,
.dream-item,
.empty-card {
  padding: 24rpx;
}

.latest-top,
.dream-item-top,
.dream-item-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.dream-title,
.dream-item-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #23262b;
}

.mood-pill,
.dream-item-mood,
.dream-item-state,
.dream-item-date {
  font-size: 22rpx;
  color: #8a9097;
}

.mood-pill {
  margin-left: 16rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #f1efe8;
}

.dream-preview,
.dream-item-preview,
.analysis-preview,
.analysis-empty,
.empty-desc {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #6f747c;
}

.analysis-preview {
  color: #555b63;
}

.analysis-empty {
  color: #959aa1;
}

.dream-list {
  display: flex;
  flex-direction: column;
}

.dream-item {
  margin-bottom: 18rpx;
}

.dream-item:last-child {
  margin-bottom: 0;
}

.dream-item-foot {
  margin-top: 16rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #23262b;
}
