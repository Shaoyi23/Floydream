<view class="detail">
  <view wx:if="{{dream}}" class="detail-wrap">
    <!-- Dream content card -->
    <view class="dream-card elevated-card">
      <view class="dream-meta">
        <view class="chip chip-active">{{dream.mood}}</view>
        <view class="dream-date">{{dream.createdAtText}}</view>
      </view>
      <view class="dream-title">{{dream.title || '未命名的梦'}}</view>
      <view class="dream-body">{{dream.content}}</view>
      <view wx:if="{{dream.tags.length}}" class="dream-tags">
        <view wx:for="{{dream.tags}}" wx:key="*this" class="chip">#{{item}}</view>
      </view>
    </view>

    <!-- AI Interpretation -->
    <view class="analysis-card elevated-card">
      <view class="analysis-head">
        <view class="analysis-title">🔮 AI 梦境解读</view>
        <view wx:if="{{dream.analysis}}" class="analysis-badge">已解读</view>
      </view>

      <block wx:if="{{dream.analysis}}">
        <view class="analysis-block">
          <view class="block-label">整体感受</view>
          <view class="block-text">{{dream.analysis.summary}}</view>
        </view>

        <view class="analysis-block" wx:if="{{dream.analysis.symbols && dream.analysis.symbols.length}}">
          <view class="block-label">关键意象</view>
          <view wx:for="{{dream.analysis.symbols}}" wx:key="name" class="symbol-item">
            <view class="symbol-name">{{item.name}}</view>
            <view class="symbol-desc">{{item.meaning}}</view>
          </view>
        </view>

        <view class="analysis-block" wx:if="{{dream.analysis.insight}}">
          <view class="block-label">心理映射</view>
          <view class="block-text">{{dream.analysis.insight}}</view>
        </view>

        <view class="analysis-block" wx:if="{{dream.analysis.suggestion}}">
          <view class="block-label">记录建议</view>
          <view class="block-text">{{dream.analysis.suggestion}}</view>
        </view>
      </block>

      <view wx:else class="analysis-empty">
        <view class="empty-icon">💤</view>
        <view class="block-text dim">这条梦境还未生成解读，点击下方按钮获取 AI 分析。</view>
      </view>

      <button class="btn-ghost refresh-btn" loading="{{isRefreshing}}" bindtap="refreshInterpretation">
        {{isRefreshing ? '解读中…' : '🔄 重新解读'}}
      </button>
    </view>

    <button class="btn-primary" bindtap="goCreate">再记一条梦</button>
  </view>

  <!-- Not found -->
  <view wx:else class="missing-card elevated-card">
    <view class="empty-icon">🌑</view>
    <view class="block-title">未找到这条梦境</view>
    <view class="block-text dim">本地记录可能已被清理，或该链接无效。</view>
    <button class="btn-primary" bindtap="goCreate">去写新的梦</button>
  </view>
</view>
