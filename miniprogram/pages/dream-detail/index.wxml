<view class="detail">
  <view wx:if="{{isLoading}}" class="loading-card elevated-card">
    <view class="loading-icon">🌤️</view>
    <view class="loading-title">正在打开这场梦…</view>
    <view class="loading-text">稍等一下，记录马上就会出现。</view>
  </view>

  <view wx:elif="{{dream}}" class="detail-wrap">
    <view class="dream-card elevated-card">
      <view class="dream-meta">
        <view class="chip chip-active">{{dream.mood}}</view>
        <view class="dream-date">{{dream.createdAtText}}</view>
      </view>
      <view class="dream-title">{{dream.title || '未命名的梦'}}</view>
      <view class="dream-body">{{dream.content}}</view>
      <view wx:if="{{dream.tags.length}}" class="dream-tags">
        <view wx:for="{{dream.tags}}" wx:key="*this" class="chip">#{{item}}</view>
      </view>
    </view>

    <view class="memory-card elevated-card">
      <view class="memory-head">
        <view class="memory-title">🌿 回看线索</view>
      </view>
      <view class="memory-grid">
        <view class="memory-item">
          <view class="memory-label">醒来感受</view>
          <view class="memory-value">{{dream.mood}}</view>
        </view>
        <view class="memory-item">
          <view class="memory-label">记录时间</view>
          <view class="memory-value">{{dream.relativeText}}</view>
        </view>
      </view>
      <view class="memory-note">
        <view class="memory-note-title">回看建议</view>
        <view class="memory-note-text">下次想起这场梦时，可以补记一个场景、一个人物，或者醒来后的第一感受。</view>
      </view>
    </view>

    <button class="btn-primary" bindtap="goCreate">再记一条梦</button>
  </view>

  <view wx:elif="{{loadFailed}}" class="missing-card elevated-card">
    <view class="empty-icon">🌤️</view>
    <view class="block-title">未找到这条梦境</view>
    <view class="block-text dim">本地记录可能已被清理，或该链接无效。</view>
    <button class="btn-primary" bindtap="goCreate">去写新的梦</button>
  </view>
</view>
