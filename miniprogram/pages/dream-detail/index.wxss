.detail {
  min-height: 100vh;
  padding: 24rpx 28rpx 60rpx;
  box-sizing: border-box;
}

/* === Dream Card === */
.dream-card {
  padding: 32rpx;
  margin-bottom: 20rpx;
}

.dream-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.dream-date {
  font-size: 22rpx;
  color: #6b6488;
}

.dream-title {
  margin-top: 20rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.3;
  letter-spacing: 1rpx;
}

.dream-body {
  margin-top: 20rpx;
  font-size: 28rpx;
  line-height: 2;
  color: #b8b0d8;
  white-space: pre-wrap;
}

.dream-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 24rpx;
}

/* === Analysis Card === */
.analysis-card {
  padding: 32rpx;
  margin-bottom: 28rpx;
}

.analysis-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.analysis-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #e0dfff;
  letter-spacing: 1rpx;
}

.analysis-badge {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #6ee7b7;
  background: rgba(110, 231, 183, 0.1);
  border: 1rpx solid rgba(110, 231, 183, 0.2);
}

/* === Analysis blocks === */
.analysis-block {
  margin-bottom: 24rpx;
}

.analysis-block:last-child {
  margin-bottom: 0;
}

.block-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #a78bfa;
  margin-bottom: 10rpx;
  letter-spacing: 1rpx;
}

.block-text {
  font-size: 26rpx;
  line-height: 1.8;
  color: #b8b0d8;
}

.block-text.dim {
  color: #6b6488;
}

.block-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #e0dfff;
  margin-bottom: 12rpx;
}

/* Symbol items */
.symbol-item {
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(167, 139, 250, 0.06);
  border: 1rpx solid rgba(167, 139, 250, 0.08);
  margin-bottom: 12rpx;
}

.symbol-item:last-child {
  margin-bottom: 0;
}

.symbol-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #c4b5fd;
  margin-bottom: 6rpx;
}

.symbol-desc {
  font-size: 24rpx;
  line-height: 1.7;
  color: #8b83b8;
}

/* Empty analysis */
.analysis-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 0;
  text-align: center;
}

.empty-icon {
  font-size: 56rpx;
  margin-bottom: 16rpx;
}

/* Refresh button */
.refresh-btn {
  width: 100%;
  margin-top: 24rpx;
}

/* Not found */
.missing-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 32rpx;
  text-align: center;
  margin-top: 40rpx;
}

.missing-card .empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.missing-card .btn-primary {
  width: 100%;
  max-width: 360rpx;
  margin-top: 36rpx;
}
