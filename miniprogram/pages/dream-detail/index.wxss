.detail {
  min-height: 100vh;
  padding: 28rpx 28rpx 72rpx;
  box-sizing: border-box;
}

.loading-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 70rpx 36rpx;
  text-align: center;
  margin-top: 24rpx;
}

.loading-icon {
  font-size: 84rpx;
  margin-bottom: 20rpx;
  animation: bob 1.8s ease-in-out infinite;
}

.loading-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #4c5675;
}

.loading-text {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #8086a2;
}

.dream-card {
  padding: 32rpx;
  margin-bottom: 20rpx;
}

.dream-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.dream-date {
  font-size: 22rpx;
  color: #9a95aa;
}

.dream-title {
  margin-top: 20rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #45506f;
  line-height: 1.3;
  letter-spacing: 1rpx;
}

.dream-body {
  margin-top: 20rpx;
  font-size: 28rpx;
  line-height: 2;
  color: #6e7393;
  white-space: pre-wrap;
}

.dream-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 24rpx;
}

.memory-card {
  padding: 32rpx;
  margin-bottom: 28rpx;
}

.memory-head {
  margin-bottom: 22rpx;
}

.memory-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #44506e;
  letter-spacing: 1rpx;
}

.memory-grid {
  display: flex;
  gap: 16rpx;
}

.memory-item {
  flex: 1;
  padding: 22rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 246, 235, 0.92);
  border: 1rpx solid rgba(255, 227, 202, 0.88);
}

.memory-label {
  font-size: 22rpx;
  color: #8d94a9;
  margin-bottom: 8rpx;
}

.memory-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #4d5c76;
}

.memory-note {
  margin-top: 18rpx;
  padding: 20rpx 22rpx;
  border-radius: 20rpx;
  background: rgba(194, 244, 231, 0.34);
  border: 1rpx solid rgba(194, 228, 220, 0.9);
}

.memory-note-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #3a7f78;
  margin-bottom: 8rpx;
}

.memory-note-text {
  font-size: 24rpx;
  line-height: 1.7;
  color: #67818d;
}

.missing-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 32rpx;
  text-align: center;
  margin-top: 40rpx;
}

.missing-card .empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.block-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #4d5776;
  margin-bottom: 12rpx;
}

.block-text {
  font-size: 26rpx;
  line-height: 1.8;
  color: #727694;
}

.block-text.dim {
  color: #8e91a9;
}

.missing-card .btn-primary {
  width: 100%;
  max-width: 360rpx;
  margin-top: 36rpx;
}

@keyframes bob {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-8rpx);
  }
}
