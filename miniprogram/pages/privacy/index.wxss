.privacy {
  min-height: 100vh;
  padding: 28rpx 28rpx 72rpx;
  box-sizing: border-box;
}

.privacy-card {
  padding: 40rpx 32rpx;
}

.privacy-hero {
  text-align: center;
  margin-bottom: 36rpx;
}

.privacy-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.privacy-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #46516f;
  letter-spacing: 2rpx;
}

.privacy-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #7d839f;
}

.privacy-section {
  margin-bottom: 28rpx;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.88);
  border: 1rpx solid rgba(255, 233, 214, 0.92);
}

.privacy-section:last-child {
  margin-bottom: 0;
}

.section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #4b5575;
  margin-bottom: 10rpx;
  letter-spacing: 1rpx;
}

.section-text {
  font-size: 24rpx;
  line-height: 1.8;
  color: #6f7492;
}
