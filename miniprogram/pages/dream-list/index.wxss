.dream-list-page {
  min-height: 100vh;
  padding: 28rpx 28rpx 72rpx;
  box-sizing: border-box;
}

.list-hero {
  padding: 18rpx 6rpx 24rpx;
}

.list-hero-badge {
  display: inline-flex;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid rgba(255, 255, 255, 0.86);
  color: #ff906d;
  font-size: 22rpx;
  font-weight: 600;
}

.list-title {
  margin-top: 18rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #485270;
}

.list-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #7b809d;
}

.list-loading,
.list-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 34rpx;
  text-align: center;
}

.list-loading-icon,
.list-empty-icon {
  font-size: 80rpx;
  margin-bottom: 18rpx;
}

.list-loading-title,
.list-empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #4b5575;
}

.list-loading-text,
.list-empty-text {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #7e84a0;
}

.list-empty .btn-primary {
  width: 100%;
  max-width: 360rpx;
  margin-top: 30rpx;
}

.list-item {
  padding: 26rpx 28rpx;
  margin-bottom: 16rpx;
}

.list-item:last-child {
  margin-bottom: 0;
}

.list-item-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.list-item-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #495371;
}

.list-item-meta {
  margin-top: 10rpx;
  font-size: 21rpx;
  color: #9690aa;
}

.list-item-body {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.75;
  color: #727795;
}

.list-item-foot {
  margin-top: 16rpx;
}

.list-tag-text {
  font-size: 22rpx;
  line-height: 1.6;
  color: #8d6d54;
}

.list-tag-text.dim {
  color: #8d93aa;
}
