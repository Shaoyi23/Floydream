.editor {
  min-height: 100vh;
  padding: 24rpx 28rpx 60rpx;
  box-sizing: border-box;
}

.editor-card {
  padding: 36rpx 32rpx;
}

/* === Header === */
.editor-header {
  text-align: center;
  margin-bottom: 32rpx;
}

.editor-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.editor-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 2rpx;
}

.editor-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #8b83b8;
}

/* === Fields === */
.field {
  margin-bottom: 28rpx;
}

.field-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #c4b5fd;
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}

.field-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  color: #e0dfff;
  font-size: 28rpx;
}

.field-input:focus {
  border-color: rgba(167, 139, 250, 0.4);
  background: rgba(255, 255, 255, 0.08);
}

.field-textarea {
  width: 100%;
  min-height: 360rpx;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  color: #e0dfff;
  font-size: 28rpx;
  line-height: 1.8;
}

.field-textarea:focus {
  border-color: rgba(167, 139, 250, 0.4);
  background: rgba(255, 255, 255, 0.08);
}

/* === Mood grid === */
.mood-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.mood-chip {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 16rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  color: #9088b8;
  font-size: 26rpx;
  transition: all 0.2s ease;
}

.mood-emoji {
  font-size: 24rpx;
  line-height: 1;
}

.mood-active {
  background: linear-gradient(135deg, rgba(124, 111, 247, 0.3), rgba(167, 139, 250, 0.2));
  border-color: rgba(167, 139, 250, 0.5);
  color: #ffffff;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(124, 111, 247, 0.2);
}

/* === Switch === */
.switch-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-radius: 18rpx;
  background: rgba(167, 139, 250, 0.06);
  border: 1rpx solid rgba(167, 139, 250, 0.1);
  margin-bottom: 32rpx;
}

.switch-text {
  flex: 1;
}

.switch-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #6b6488;
  line-height: 1.5;
}

/* === Submit === */
.submit-btn {
  width: 100%;
}
