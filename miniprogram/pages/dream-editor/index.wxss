.editor {
  min-height: 100vh;
  padding: 28rpx 28rpx 96rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at top, rgba(255, 205, 151, 0.34) 0%, rgba(255, 205, 151, 0) 36%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.20) 0%, rgba(255, 255, 255, 0.04) 100%);
}

.editor-card {
  padding: 40rpx 32rpx 32rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(255, 249, 242, 0.98));
}

.editor-header {
  text-align: center;
  margin-bottom: 32rpx;
}

.editor-badge {
  display: inline-flex;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 245, 234, 0.92);
  border: 1rpx solid rgba(255, 220, 191, 0.92);
  color: #ff8f6d;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.editor-icon {
  font-size: 64rpx;
  margin: 18rpx 0 16rpx;
}

.editor-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #46516f;
  letter-spacing: 2rpx;
}

.editor-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #7c83a0;
}

.field {
  margin-bottom: 28rpx;
}

.field-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #54607f;
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}

.field-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(255, 217, 196, 0.92);
  color: #4b5271;
  font-size: 28rpx;
}

.field-input:focus {
  border-color: rgba(255, 157, 125, 0.54);
  background: #ffffff;
}

.field-textarea {
  width: 100%;
  min-height: 360rpx;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(255, 217, 196, 0.92);
  color: #4b5271;
  font-size: 28rpx;
  line-height: 1.8;
}

.field-textarea:focus {
  border-color: rgba(255, 157, 125, 0.54);
  background: #ffffff;
}

.mood-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.mood-chip {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 16rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.88);
  border: 1rpx solid rgba(197, 234, 228, 0.92);
  color: #5f6e82;
  font-size: 26rpx;
  transition: all 0.2s ease;
}

.mood-emoji {
  font-size: 24rpx;
  line-height: 1;
}

.mood-active {
  background: linear-gradient(135deg, rgba(255, 144, 111, 0.90), rgba(255, 196, 109, 0.84));
  border-color: rgba(255, 184, 136, 0.88);
  color: #ffffff;
  font-weight: 600;
  box-shadow: 0 10rpx 18rpx rgba(255, 149, 113, 0.18);
}

.tip-panel {
  padding: 24rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, rgba(196, 244, 231, 0.36), rgba(255, 241, 225, 0.82));
  border: 1rpx solid rgba(210, 235, 228, 0.96);
  margin-bottom: 32rpx;
}

.tip-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #3b7f78;
  margin-bottom: 8rpx;
}

.tip-text {
  font-size: 22rpx;
  color: #67818d;
  line-height: 1.7;
}

.submit-panel {
  margin-top: 8rpx;
  padding: 18rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(255, 244, 234, 0.98));
  border: 1rpx solid rgba(255, 228, 207, 0.96);
}

.submit-btn {
  width: 100%;
}

.submit-hint {
  margin-top: 16rpx;
  text-align: center;
  font-size: 22rpx;
  color: #848ca6;
  letter-spacing: 1rpx;
}
