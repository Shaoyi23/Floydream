.editor {
  min-height: 100vh;
  padding: 28rpx 28rpx 96rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at top, rgba(255, 214, 236, 0.08) 0%, rgba(255, 214, 236, 0) 34%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.02) 0%, rgba(255, 255, 255, 0.01) 100%);
}

.editor-card {
  padding: 40rpx 32rpx 32rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.13), rgba(255, 255, 255, 0.08));
}

/* === Header === */
.editor-header {
  text-align: center;
  margin-bottom: 32rpx;
}

.editor-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.editor-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff8ff;
  letter-spacing: 2rpx;
}

.editor-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #cbc1e8;
}

/* === Fields === */
.field {
  margin-bottom: 28rpx;
}

.field-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #eee5ff;
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}

.field-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  color: #f3eeff;
  font-size: 28rpx;
}

.field-input:focus {
  border-color: rgba(169, 150, 255, 0.45);
  background: rgba(255, 255, 255, 0.12);
}

.field-textarea {
  width: 100%;
  min-height: 360rpx;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  color: #f3eeff;
  font-size: 28rpx;
  line-height: 1.8;
}

.field-textarea:focus {
  border-color: rgba(169, 150, 255, 0.45);
  background: rgba(255, 255, 255, 0.12);
}

/* === Mood grid === */
.mood-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.mood-chip {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 16rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.11);
  color: #d0c5ef;
  font-size: 26rpx;
  transition: all 0.2s ease;
}

.mood-emoji {
  font-size: 24rpx;
  line-height: 1;
}

.mood-active {
  background: linear-gradient(135deg, rgba(125, 109, 246, 0.4), rgba(240, 167, 204, 0.18));
  border-color: rgba(214, 194, 255, 0.5);
  color: #ffffff;
  font-weight: 600;
  box-shadow: 0 8rpx 18rpx rgba(125, 109, 246, 0.18);
}

/* === Switch === */
.switch-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, rgba(169, 150, 255, 0.1), rgba(240, 167, 204, 0.08));
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  margin-bottom: 32rpx;
}

.switch-text {
  flex: 1;
}

.switch-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #c5bbdf;
  line-height: 1.5;
}

/* === Submit === */
.submit-panel {
  margin-top: 8rpx;
  padding: 18rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.10), rgba(255, 255, 255, 0.05));
  border: 1rpx solid rgba(255, 255, 255, 0.12);
}

.submit-btn {
  width: 100%;
}

.submit-hint {
  margin-top: 16rpx;
  text-align: center;
  font-size: 22rpx;
  color: #d0c5eb;
  letter-spacing: 1rpx;
}
