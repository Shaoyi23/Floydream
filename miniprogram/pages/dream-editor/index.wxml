<view class="editor">
  <view class="editor-card elevated-card">
    <view class="editor-header">
      <view class="editor-badge">晨间速记</view>
      <view class="editor-icon">🌼</view>
      <view class="editor-title">把这场梦轻轻写下来</view>
      <view class="editor-desc">不需要完整复述。先抓住最鲜明的画面、人物和情绪，其他细节以后还可以慢慢补。</view>
    </view>

    <view class="field">
      <view class="field-label">梦境标题</view>
      <input
        class="field-input"
        placeholder="比如：一直上不去的电梯"
        value="{{title}}"
        data-field="title"
        bindinput="handleInput"
      />
    </view>

    <view class="field">
      <view class="field-label">醒来时的感受</view>
      <view class="mood-grid">
        <view
          wx:for="{{moods}}"
          wx:key="*this"
          class="mood-chip {{mood === item ? 'mood-active' : ''}}"
          data-mood="{{item}}"
          bindtap="selectMood"
        >
          <view class="mood-emoji">
            {{item === '开心' ? '😊' : ''}}
            {{item === '平静' ? '😌' : ''}}
            {{item === '奇妙' ? '✨' : ''}}
            {{item === '紧张' ? '😰' : ''}}
            {{item === '害怕' ? '😨' : ''}}
            {{item === '悲伤' ? '😢' : ''}}
          </view>
          <view>{{item}}</view>
        </view>
      </view>
    </view>

    <view class="field">
      <view class="field-label">梦境内容</view>
      <textarea
        class="field-textarea"
        maxlength="-1"
        placeholder="把还记得的片段都写下来…&#10;&#10;场景、人物、重复的细节、身体的感受——写到哪里算哪里。"
        value="{{content}}"
        data-field="content"
        bindinput="handleInput"
      />
    </view>

    <view class="field">
      <view class="field-label">关键词</view>
      <input
        class="field-input"
        placeholder="用空格或逗号分隔，例如：海水 追逐 旧房间"
        value="{{tagsInput}}"
        data-field="tagsInput"
        bindinput="handleInput"
      />
    </view>

    <view class="tip-panel">
      <view class="tip-title">记录小贴士</view>
      <view class="tip-text">先写最难忘的一幕，再补醒来时的感受和两个关键词，这样以后回看会更清晰。</view>
    </view>

    <view class="submit-panel">
      <button class="btn-primary submit-btn" loading="{{isSubmitting}}" bindtap="submitDream">
        {{isSubmitting ? '正在收好…' : '收好这场梦'}}
      </button>
      <view class="submit-hint">你记录下来的每个片段，都会慢慢变成自己的梦境地图。</view>
    </view>
  </view>
</view>
