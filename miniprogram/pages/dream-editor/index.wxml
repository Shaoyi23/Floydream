<view class="editor">
  <view class="editor-card elevated-card">
    <view class="editor-header">
      <view class="editor-icon">💭</view>
      <view class="editor-title">梦里发生了什么？</view>
      <view class="editor-desc">不用追求完整。哪怕只记得一个房间、一句对白、一种颜色，都值得被留下。</view>
    </view>

    <view class="field">
      <view class="field-label">梦境标题</view>
      <input
        class="field-input"
        placeholder="比如：一直上不去的电梯"
        value="{{title}}"
        data-field="title"
        bindinput="handleInput"
      />
    </view>

    <view class="field">
      <view class="field-label">醒来时的感受</view>
      <view class="mood-grid">
        <view
          wx:for="{{moods}}"
          wx:key="*this"
          class="mood-chip {{mood === item ? 'mood-active' : ''}}"
          data-mood="{{item}}"
          bindtap="selectMood"
        >
          <view class="mood-emoji">
            {{item === '开心' ? '😊' : ''}}
            {{item === '平静' ? '😌' : ''}}
            {{item === '奇妙' ? '✨' : ''}}
            {{item === '紧张' ? '😰' : ''}}
            {{item === '害怕' ? '😨' : ''}}
            {{item === '悲伤' ? '😢' : ''}}
          </view>
          <view>{{item}}</view>
        </view>
      </view>
    </view>

    <view class="field">
      <view class="field-label">梦境内容</view>
      <textarea
        class="field-textarea"
        maxlength="-1"
        placeholder="把还记得的片段都写下来…&#10;&#10;场景、人物、重复的细节、身体的感受——写到哪里算哪里。"
        value="{{content}}"
        data-field="content"
        bindinput="handleInput"
      />
    </view>

    <view class="field">
      <view class="field-label">关键词</view>
      <input
        class="field-input"
        placeholder="用空格或逗号分隔，例如：海水 追逐 旧房间"
        value="{{tagsInput}}"
        data-field="tagsInput"
        bindinput="handleInput"
      />
    </view>

    <view class="switch-field">
      <view class="switch-text">
        <view class="field-label">AI 解读</view>
        <view class="switch-desc">调用 DeepSeek 模型解析梦境意象与情感</view>
      </view>
      <switch color="#a78bfa" checked="{{needInterpretation}}" bindchange="toggleInterpretation" />
    </view>

    <button class="btn-primary submit-btn" loading="{{isSubmitting}}" bindtap="submitDream">
      {{isSubmitting ? '正在保存…' : '保存这场梦'}}
    </button>
  </view>
</view>
