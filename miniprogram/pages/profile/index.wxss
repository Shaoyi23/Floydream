.profile {
  min-height: 100vh;
  padding: 0 28rpx 72rpx;
  box-sizing: border-box;
}

.profile-hero {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 54rpx 20rpx 36rpx;
  text-align: center;
  overflow: hidden;
}

.profile-glow {
  position: absolute;
  top: -80rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 400rpx;
  height: 400rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 195, 123, 0.24) 0%, rgba(255, 195, 123, 0.06) 42%, transparent 70%);
  pointer-events: none;
}

.avatar {
  font-size: 72rpx;
  margin-bottom: 20rpx;
  filter: drop-shadow(0 10rpx 18rpx rgba(255, 160, 120, 0.22));
}

.profile-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #45506f;
  letter-spacing: 2rpx;
}

.profile-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #7f84a1;
  line-height: 1.6;
  max-width: 440rpx;
}

.stats-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 12rpx;
}

.stat-num {
  font-size: 42rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #ff8f6d, #4eb2ae);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.stat-label {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #8b93ac;
  letter-spacing: 1rpx;
}

.panel {
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.panel-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #4b5575;
  margin-bottom: 18rpx;
  letter-spacing: 1rpx;
}

.panel-empty {
  font-size: 24rpx;
  color: #8e91a9;
  padding: 16rpx 0;
}

.latest-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.latest-main {
  flex: 1;
}

.latest-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #45506f;
  margin-bottom: 8rpx;
}

.latest-meta {
  font-size: 22rpx;
  color: #9297ad;
}

.latest-arrow {
  font-size: 28rpx;
  color: #f08f6e;
  margin-left: 16rpx;
}

.tip-item {
  display: flex;
  margin-bottom: 16rpx;
}

.tip-item:last-child {
  margin-bottom: 0;
}

.tip-num {
  font-size: 22rpx;
  font-weight: 700;
  color: #ff926e;
  margin-right: 14rpx;
  flex-shrink: 0;
  opacity: 0.6;
}

.tip-text {
  font-size: 24rpx;
  line-height: 1.7;
  color: #727694;
}

.service-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.service-main {
  flex: 1;
}

.service-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #45506f;
}

.service-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #7b80a0;
}

.service-note {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: rgba(255, 243, 230, 0.88);
  border: 1rpx solid rgba(255, 223, 199, 0.88);
  font-size: 22rpx;
  line-height: 1.7;
  color: #8c775f;
}
