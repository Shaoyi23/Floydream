.profile {
  min-height: 100vh;
  padding: 0 28rpx 60rpx;
  box-sizing: border-box;
}

/* === Hero === */
.profile-hero {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 56rpx 20rpx 36rpx;
  text-align: center;
  overflow: hidden;
}

.profile-glow {
  position: absolute;
  top: -80rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 400rpx;
  height: 400rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(167, 139, 250, 0.12) 0%, rgba(167, 139, 250, 0.04) 40%, transparent 70%);
  pointer-events: none;
}

.avatar {
  font-size: 72rpx;
  margin-bottom: 20rpx;
  filter: drop-shadow(0 0 24rpx rgba(167, 139, 250, 0.4));
}

.profile-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 2rpx;
}

.profile-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #7b73a8;
  line-height: 1.6;
  max-width: 440rpx;
}

/* === Stats === */
.stats-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 12rpx;
}

.stat-num {
  font-size: 42rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #e0dfff, #c4b5fd);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.stat-label {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #7b73a8;
  letter-spacing: 1rpx;
}

/* === Panel === */
.panel {
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.panel-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #c4b5fd;
  margin-bottom: 18rpx;
  letter-spacing: 1rpx;
}

.panel-empty {
  font-size: 24rpx;
  color: #6b6488;
  padding: 16rpx 0;
}

/* === Latest row === */
.latest-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.latest-main {
  flex: 1;
}

.latest-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #e0dfff;
  margin-bottom: 8rpx;
}

.latest-meta {
  font-size: 22rpx;
  color: #6b6488;
}

.latest-arrow {
  font-size: 28rpx;
  color: #7b73a8;
  margin-left: 16rpx;
}

/* === Tips === */
.tip-item {
  display: flex;
  margin-bottom: 16rpx;
}

.tip-item:last-child {
  margin-bottom: 0;
}

.tip-num {
  font-size: 22rpx;
  font-weight: 700;
  color: #a78bfa;
  margin-right: 14rpx;
  flex-shrink: 0;
  opacity: 0.6;
}

.tip-text {
  font-size: 24rpx;
  line-height: 1.7;
  color: #8b83b8;
}
