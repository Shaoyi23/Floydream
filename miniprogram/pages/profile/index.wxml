<view class="profile">
  <!-- Header -->
  <view class="profile-hero">
    <view class="profile-glow"></view>
    <view class="avatar">🌷</view>
    <view class="profile-name">我的梦境档案</view>
    <view class="profile-desc">把散落的片段慢慢收成一本只属于自己的清晨笔记。</view>
  </view>

  <view class="stats-row">
    <view class="stat-item glass-card">
      <view class="stat-num">{{stats.total}}</view>
      <view class="stat-label">累计记录</view>
    </view>
    <view class="stat-item glass-card">
      <view class="stat-num">{{stats.tagged}}</view>
      <view class="stat-label">带关键词</view>
    </view>
    <view class="stat-item glass-card">
      <view class="stat-num">{{stats.streak}}</view>
      <view class="stat-label">记录天数</view>
    </view>
  </view>

  <view class="panel elevated-card">
    <view class="panel-title">最近一次记录</view>
    <view wx:if="{{latestDream}}" class="latest-row" bindtap="goLatestDream">
      <view class="latest-main">
        <view class="latest-title">{{latestDream.title || '未命名的梦'}}</view>
        <view class="latest-meta">{{latestDream.createdAtText}} · {{latestDream.mood}}</view>
      </view>
      <view class="latest-arrow">→</view>
    </view>
    <view wx:else class="panel-empty">还没有记录过梦境</view>
  </view>

  <view class="panel elevated-card">
    <view class="panel-title">记录贴士</view>
    <view class="tip-item">
      <view class="tip-num">01</view>
      <view class="tip-text">连续记录 7 天，你会开始看到重复出现的人、地点和情绪模式。</view>
    </view>
    <view class="tip-item">
      <view class="tip-num">02</view>
      <view class="tip-text">醒来后先别动，闭眼回想 30 秒——这是捕捉梦境的最佳时机。</view>
    </view>
    <view class="tip-item">
      <view class="tip-num">03</view>
      <view class="tip-text">不必追求完整叙事。一个颜色、一种触感、一句话，都是有效的碎片。</view>
    </view>
  </view>

  <view class="panel elevated-card">
    <view class="panel-title">服务说明</view>
    <view class="service-row" bindtap="goPrivacy">
      <view class="service-main">
        <view class="service-title">隐私说明</view>
        <view class="service-desc">查看梦境记录与云端存储的数据使用方式</view>
      </view>
      <view class="latest-arrow">→</view>
    </view>
    <view class="service-note">这里只保留你主动写下的梦境内容、情绪和关键词，方便自己回看整理。</view>
  </view>

  <button class="btn-primary" bindtap="goCreate">✦ 再写一条新的梦</button>
</view>
