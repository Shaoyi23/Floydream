page {
  background:
    radial-gradient(circle at top left, rgba(255, 221, 179, 0.9) 0%, rgba(255, 221, 179, 0) 32%),
    radial-gradient(circle at top right, rgba(194, 244, 231, 0.72) 0%, rgba(194, 244, 231, 0) 28%),
    linear-gradient(180deg, #fff8f1 0%, #fff3ea 45%, #fefaf4 100%);
  background-color: #fff7f0;
  min-height: 100vh;
  font-size: 16px;
  line-height: 1.6;
  color: #3f4465;
  font-family: -apple-system-font, "PingFang SC", "Helvetica Neue", sans-serif;
}

page > view {
  width: 100vw;
  max-width: 600px;
}

button {
  margin: 0;
  padding: 0;
  border: none;
  font-size: inherit;
}

button::after {
  border: none;
}

input, textarea {
  color: #4a4f70;
  font-family: inherit;
}

input::placeholder, textarea::placeholder {
  color: rgba(116, 121, 154, 0.55);
}

/* === Design Tokens === */

/* Glass card — frosted translucent surface */
.glass-card {
  background: rgba(255, 255, 255, 0.88);
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 28rpx;
  box-shadow: 0 18rpx 44rpx rgba(255, 138, 107, 0.10);
}

/* Elevated card */
.elevated-card {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(255, 249, 241, 0.98));
  border: 1rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 24rpx;
  box-shadow: 0 20rpx 56rpx rgba(255, 150, 120, 0.12);
}

/* Primary CTA button */
.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #ff8f6d 0%, #ffb56f 58%, #ffd06e 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  box-shadow: 0 14rpx 30rpx rgba(255, 143, 109, 0.28);
  transition: all 0.2s ease;
}

.btn-primary:active {
  transform: scale(0.97);
  opacity: 0.9;
}

/* Ghost / secondary button */
.btn-ghost {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: 48rpx;
  background: rgba(135, 225, 201, 0.14);
  border: 1rpx solid rgba(135, 225, 201, 0.26);
  color: #2d7f78;
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  transition: all 0.2s ease;
}

.btn-ghost:active {
  background: rgba(255, 255, 255, 0.14);
}

/* Text pill / chip */
.chip {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: rgba(132, 222, 202, 0.18);
  color: #25706b;
  border: 1rpx solid rgba(132, 222, 202, 0.28);
}

.chip-active {
  background: linear-gradient(135deg, #ff8f6d, #ffb56f);
  color: #ffffff;
  border-color: transparent;
}

/* Section title */
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx;
  margin-bottom: 20rpx;
}

.section-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #4e5373;
  letter-spacing: 1rpx;
}
