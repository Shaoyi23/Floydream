page {
  background:
    radial-gradient(circle at top, rgba(255, 214, 236, 0.12) 0%, rgba(255, 214, 236, 0) 34%),
    linear-gradient(180deg, #18142f 0%, #262042 24%, #302953 62%, #2a2348 100%);
  background-color: #241d42;
  min-height: 100vh;
  font-size: 16px;
  line-height: 1.6;
  color: #f4efff;
  font-family: -apple-system-font, "PingFang SC", "Helvetica Neue", sans-serif;
}

page > view {
  width: 100vw;
  max-width: 600px;
}

button {
  margin: 0;
  padding: 0;
  border: none;
  font-size: inherit;
}

button::after {
  border: none;
}

input, textarea {
  color: #e0dfff;
  font-family: inherit;
}

input::placeholder, textarea::placeholder {
  color: rgba(200, 195, 230, 0.4);
}

/* === Design Tokens === */

/* Glass card — frosted translucent surface */
.glass-card {
  background: rgba(255, 255, 255, 0.07);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 28rpx;
  box-shadow: 0 16rpx 44rpx rgba(14, 10, 34, 0.12);
}

/* Elevated card */
.elevated-card {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.07));
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 24rpx;
  box-shadow: 0 18rpx 56rpx rgba(10, 7, 25, 0.22);
}

/* Primary CTA button */
.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #7d6df6 0%, #a996ff 52%, #f0a7cc 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  box-shadow: 0 12rpx 30rpx rgba(125, 109, 246, 0.28);
  transition: all 0.2s ease;
}

.btn-primary:active {
  transform: scale(0.97);
  opacity: 0.9;
}

/* Ghost / secondary button */
.btn-ghost {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: 48rpx;
  background: rgba(255, 255, 255, 0.09);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  color: #e5dcff;
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  transition: all 0.2s ease;
}

.btn-ghost:active {
  background: rgba(255, 255, 255, 0.14);
}

/* Text pill / chip */
.chip {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: rgba(201, 189, 255, 0.13);
  color: #eee6ff;
  border: 1rpx solid rgba(201, 189, 255, 0.18);
}

.chip-active {
  background: linear-gradient(135deg, #7c6ff7, #a78bfa);
  color: #ffffff;
  border-color: transparent;
}

/* Section title */
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx;
  margin-bottom: 20rpx;
}

.section-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #ece3ff;
  letter-spacing: 1rpx;
}
